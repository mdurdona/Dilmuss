DATABASE_URL="postgresql://dilmuss:dilmuss_dev_pw@localhost:5432/dilmuss_dev?schema=public"
# `npm test` shu bazaga ulanadi, DATABASE_URL'ga emas — shunday qilib testlar hech qachon
# dev/production ma'lumotlariga tasodifan tegmaydi. Baza nomida "test" so'zi bo'lishi shart
# (src/test/db-fixtures.ts shuni tekshiradi, aks holda testlar ishga tushmaydi).
TEST_DATABASE_URL="postgresql://dilmuss:dilmuss_dev_pw@localhost:5432/dilmuss_test?schema=public"

# Productionda majburiy: kamida 32 belgi, quyidagi namuna qiymat bilan bir xil bo'lmasligi kerak
# (startup shu ikkalasini tekshiradi — src/common/utils/production-config.ts).
# Refresh token JWT emas — tasodifiy hex qiymat, DB'da hash qilinib saqlanadi, shuning uchun uning
# uchun alohida sir kerak emas.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"

PORT=4000
CORS_ORIGIN="http://localhost:3000"

STOCK_RESERVATION_TTL_MINUTES=15

# Payme (sandbox)
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""
PAYME_TEST_KEY=""

# Click (sandbox)
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""

# Telegram bot (admin/notification adapter)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
